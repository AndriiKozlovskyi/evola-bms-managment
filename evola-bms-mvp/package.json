    "@capacitor/cli": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.1.0"
  }
